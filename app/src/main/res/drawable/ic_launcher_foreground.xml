<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground. The system masks this to whatever shape the launcher uses and may
  parallax it, so the artwork is inset well inside the 108dp canvas — the outer ~18dp on each
  edge can be cropped on any given device.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group android:scaleX="2.6"
        android:scaleY="2.6"
        android:translateX="22.8"
        android:translateY="22.8">
        <!-- Shield outline -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M12,1L3,5v6c0,5.55 3.84,10.74 9,12 5.16,-1.26 9,-6.45 9,-12V5l-9,-4z" />
        <!-- Cut-out check, drawn in the background tone so it reads at small sizes -->
        <path
            android:fillColor="#1B6E3C"
            android:pathData="M10.6,15.4l-3,-3 1.4,-1.4 1.6,1.6 4.4,-4.4 1.4,1.4z" />
    </group>
</vector>
