<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!--
      Themed-icon layer. Without it the launcher falls back to the full-colour icon when the
      user turns on themed icons, which looks broken next to every other app on the home
      screen. The system recolours this from the wallpaper palette, so it must be a flat
      silhouette.
    -->
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
